# ===========================================================================
# Multilingual file for the TOS 7 Docker application "openlistdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "OpenList"
auth         = "OpenListTeam"
version      = "@@VERSION@@"
descript     = "OpenList is a file-list program that aggregates local storage and cloud drives behind one web UI, with WebDAV access, file preview, upload and offline download. This package runs the official Docker Hub image unmodified as a non-root container; the first visit opens a setup wizard where the administrator password is set, and all data stays in the application data folder."
release_note = "1. Review remediation: PRIVACY.md and NOTICE.md added, README privacy / third-party / licence sections, the help field now opens the privacy policy, and the Chinese descriptions were rewritten (they described another application). 2. Upgraded upstream to openlistteam/openlist:v4.2.9: no initial admin password is written to the container log - the first visit opens the setup wizard."
important    = "First visit http://<NAS-IP>:8086/ opens the setup wizard: set the administrator account there, nothing is written to the container log. Data lives in /Volume1/DockerAppData/openlistdocker/ and survives restarts. Forgot the password: docker exec openlistdocker ./openlist admin set <new-password>. The container runs as uid 1000. Needs DockerEngine; configure a registry mirror if Docker Hub is unreachable. Back up the data folder before uninstalling with data removal. Plain HTTP on the LAN."

[zh-cn]
name         = "OpenList"
auth         = "OpenListTeam"
version      = "@@VERSION@@"
descript     = "OpenList 是一个文件列表程序：把本地存储和各类云盘聚合到一个网页界面，支持 WebDAV 访问、文件预览、上传与离线下载。本应用直接运行 Docker Hub 官方镜像（非 root），首次访问会进入安装向导设置管理员密码，所有数据保存在应用数据目录。"
release_note = "1. Review remediation: PRIVACY.md and NOTICE.md added, README privacy / third-party / licence sections, the help field now opens the privacy policy, and the Chinese descriptions were rewritten (they described another application). 2. Upgraded upstream to openlistteam/openlist:v4.2.9: no initial admin password is written to the container log - the first visit opens the setup wizard."
important    = "首次访问 http://<NAS-IP>:8086/ 会打开安装向导，请在其中设置管理员账户，本版本不会把密码写入容器日志。数据保存在 DockerAppData/openlistdocker，重启和升级不会丢失。忘记密码可在 NAS 上运行 docker exec openlistdocker ./openlist admin set <新密码> 重设。容器以 uid 1000 运行。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。卸载并删除数据前请备份。局域网内为 HTTP。"

[zh-hk]
name         = "OpenList"
auth         = "OpenListTeam"
version      = "@@VERSION@@"
descript     = "OpenList 是一個檔案清單程式：把本機儲存與各類雲端硬碟聚合到一個網頁介面，支援 WebDAV 存取、檔案預覽、上傳與離線下載。本應用直接執行 Docker Hub 官方映像（非 root），首次存取會進入安裝精靈設定管理員密碼，所有資料保存在應用資料目錄。"
release_note = "1. Review remediation: PRIVACY.md and NOTICE.md added, README privacy / third-party / licence sections, the help field now opens the privacy policy, and the Chinese descriptions were rewritten (they described another application). 2. Upgraded upstream to openlistteam/openlist:v4.2.9: no initial admin password is written to the container log - the first visit opens the setup wizard."
important    = "首次存取 http://<NAS-IP>:8086/ 會開啟安裝精靈，請在其中設定管理員帳戶，本版本不會把密碼寫入容器日誌。資料保存在 DockerAppData/openlistdocker，重新啟動和升級不會遺失。忘記密碼可在 NAS 上執行 docker exec openlistdocker ./openlist admin set <新密碼> 重設。容器以 uid 1000 運行。需要 DockerEngine；Docker Hub 不可達時先設定鏡像加速。解除安裝並刪除資料前請備份。區域網路內為 HTTP。"

